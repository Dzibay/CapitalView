# Copy to .env and set secrets. This is the only configuration file required.
ENVIRONMENT=production
DOMAIN=localhost
JWT_SECRET_KEY=change-me-to-a-long-random-secret
DB_NAME=capitalview
DB_USER=capitalview
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=postgres
DB_PORT=5432
DB_POOL_ASYNC_MIN=1
DB_POOL_ASYNC_MAX=4
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api
VITE_YM_COUNTER_ID=
VITE_YANDEX_VERIFICATION_ID=
REFERENCE_SEED_ENABLED=true
REFERENCE_SEED_VERSION=1
REFERENCE_SCHEDULER_POLL_SECONDS=300
REFERENCE_PROGRESS=0
REFERENCE_UPDATE_INTERVAL_SECONDS=86400
WEB_WORKERS=2
LOG_LEVEL=INFO
LOG_FORMAT=production
